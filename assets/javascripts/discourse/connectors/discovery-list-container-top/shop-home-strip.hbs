<div class="shop-home-links" style="margin: 8px 0 16px; display:flex; gap:8px; flex-wrap:wrap;">
  <a class="btn btn-primary" href="/shop/public/products">{i18n "shop.nav.shop" default="商城"}</a>
  {#if currentUser.staff}
    <a class="btn" href="/admin/plugins/discourse-shop-pro-20250818-fix13-allinone-ship-kd100-home-topnav#products">{i18n "shop.nav.products" default="商品"}</a>
    <a class="btn" href="/admin/plugins/discourse-shop-pro-20250818-fix13-allinone-ship-kd100-home-topnav#orders">{i18n "shop.nav.orders" default="订单"}</a>
    <a class="btn" href="/admin/plugins/discourse-shop-pro-20250818-fix13-allinone-ship-kd100-home-topnav#logistics">{i18n "shop.nav.logistics" default="物流"}</a>
    <a class="btn" href="/admin/plugins/discourse-shop-pro-20250818-fix13-allinone-ship-kd100-home-topnav/settings">{i18n "shop.nav.settings" default="设置"}</a>
  {/if}
</div>
<div class="shop-home-strip card">
  <div class="shop-home-strip__header">
    <h3>{{i18n "shop.featured"}}</h3>
    <div class="pager">
      <DButton @icon="chevron-left" @action={{this.prev}} @disabled={{this.isFirst}} />
      <DButton @icon="chevron-right" @action={{this.next}} @disabled={{this.isLast}} />
    </div>
  </div>
  <div class="shop-home-strip__grid">
    {{#each this.visible as |p|}}
      <a class="item" href="{{this.productURL p.id}}" target="_blank">
        {{#if p.first_image}}
          <img src="{{p.first_image}}" alt="product">
        {{/if}}
        <div class="title">{{p.title}}</div>
        <div class="price">¥{{price-cny p.price_cents}}</div>
      </a>
    {{/each}}
  </div>
</div>
