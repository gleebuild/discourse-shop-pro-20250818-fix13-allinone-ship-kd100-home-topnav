<h1>Shop Admin — Products</h1>

<form id=\"new-product\" action=\"/shop/admin/products\" method=\"post\">
  <input type=\"hidden\" name=\"authenticity_token\" id=\"csrfField\">
  <div style=\"margin:8px 0\">
    <label>Name</label><br>
    <input type=\"text\" name=\"name\" required style=\"min-width:320px\">
  </div>
  <div style=\"margin:8px 0\">
    <label>Price</label><br>
    <input type=\"text\" name=\"price\" placeholder=\"e.g. 9.99\">
  </div>
  <div style=\"margin:8px 0\">
    <label>Image</label><br>
    <input type=\"file\" id=\"imageFile\" accept=\"image/*\">
    <input type=\"hidden\" name=\"upload_id\" id=\"uploadId\">
    <div id=\"preview\" style=\"margin-top:6px\"></div>
    <div id=\"uploadStatus\" style=\"color:#888;margin-top:4px\"></div>
  </div>
  <button type=\"submit\">Create Product</button>
</form>

<hr>
<h2>Current Products</h2>
<% if @products.blank? %>
  <p>(none)</p>
<% else %>
  <ul>
  <% @products.each do |p| %>
    <li>
      <b><%= p['name'] %></b> — <%= p['price'] %>
      <% if p['image_url'].present? %>
        <img src=\"<%= p['image_url'] %>\" style=\"max-height:60px;vertical-align:middle;margin-left:8px\">
      <% end %>
    </li>
  <% end %>
  </ul>
<% end %>

<script>
(function(){
  const csrf = document.querySelector('meta[name=\"csrf-token\"]')?.content;
  if (csrf) document.getElementById('csrfField').value = csrf;

  const fileInput = document.getElementById('imageFile');
  const uploadIdField = document.getElementById('uploadId');
  const statusEl = document.getElementById('uploadStatus');
  const preview = document.getElementById('preview');

  async function uploadFile(file){
    statusEl.textContent = 'Uploading...';
    const fd = new FormData();
    fd.append('type', 'composer');
    fd.append('file', file, file.name);
    try{
      const res = await fetch('/uploads.json', {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrf },
        body: fd
      });
      if(!res.ok){
        const t = await res.text();
        throw new Error('Upload failed: ' + t);
      }
      const data = await res.json();
      uploadIdField.value = data.id;
      statusEl.textContent = 'Uploaded ✓';
      preview.innerHTML = '<img style=\"max-height:90px\" src="' + data.url + '">';
    }catch(e){
      console.error(e);
      statusEl.textContent = e.message;
    }
  }

  fileInput?.addEventListener('change', (e)=>{
    const file = e.target.files && e.target.files[0];
    if(file){
      uploadFile(file);
    }
  });
})();
</script>
