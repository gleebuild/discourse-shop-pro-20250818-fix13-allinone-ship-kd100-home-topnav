<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= @product.title %></title>
<style>body{font-family:-apple-system,BlinkMacSystemFont,Roboto,Arial,sans-serif;max-width:820px;margin:0 auto;padding:16px}.gallery img{height:120px;border-radius:8px;margin-right:8px}.btn{padding:10px 16px;border:0;border-radius:8px;background:#0ea5e9;color:#fff;font-weight:600;cursor:pointer}</style></head><body>
<a href="<%= Discourse.base_uri %>/shop/public/products" class="muted">← 返回</a><h2><%= @product.title %></h2>
<div class="gallery"><% Array(@product.images).each do |img| %><img src="<%= img %>"><% end %></div>
<p><%= @product.description %></p>
<button class="btn" onclick="location.href='<%= Discourse.base_uri %>/shop/public/products'">返回列表</button>
</body></html>
