<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>商品列表</title>
<style>.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}.card{border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;background:#fff;display:flex;flex-direction:column}.thumb{width:100%;height:160px;object-fit:cover;background:#f3f4f6}.title{font-weight:700;padding:10px 12px 0;font-size:16px}.price{color:#ef4444;font-weight:700;padding:4px 12px 10px}.btn{margin:0 12px 12px;padding:10px 12px;border:0;border-radius:8px;background:#0ea5e9;color:#fff;font-weight:600;text-align:center;text-decoration:none}</style></head><body>
<h2>商品列表</h2><div class="grid">
<% @products.each do |p| %><div class="card">
<% img = Array(p.images).first %>
<% if img.present? %><img class="thumb" src="<%= img %>"><% else %><div class="thumb"></div><% end %>
<div class="title"><%= p.title %></div>
<% price = (Array(p.specs).first || {})["price_cents"].to_i / 100.0 rescue 0 %>
<div class="price">¥<%= ('%.2f' % price) %></div>
<a class="btn" href="<%= Discourse.base_uri %>/shop/public/products/<%= p.id %>">查看详情</a>
</div><% end %></div></body></html>
